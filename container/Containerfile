# Minimal Debian Bookworm build/run environment for the PocketBook 6.10 SDKs.
# xvfb, xdotool and imagemagick are for pb test: a virtual display, input and screenshots.
# The SDK's prebuilt host tools (qmake, moc, x86 Qt, libinkview) are linked
# against Bookworm libraries, so they must run inside this image.
FROM docker.io/library/debian:bookworm

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential pkg-config file clang-15 \
        curl ca-certificates libarchive-tools \
        libfreetype-dev libfontconfig1 libboost-dev libjpeg62-turbo-dev \
        libgtk2.0-0 libpangoxft-1.0-0 \
        libssl3 libicu72 libjsoncpp25 libcurl4 libjpeg62-turbo libtiff6 libpng16-16 \
        libglib2.0-0 libpcre2-16-0 libdouble-conversion3 libzstd1 libb2-1 \
        libx11-6 libxkbcommon0 libegl1 libgl1 libopengl0 libdbus-1-3 \
        libjson-c5 libtag1v5 libsqlite3-0 libsqlite3-dev libopencv-core406 libopencv-imgproc406 \
        libnss3 libnspr4 libopus0 libasound2 libevent-2.1-7 libharfbuzz-subset0 \
        libpci3 libsnappy1v5 libwebpdemux2 libwebpmux3 \
        fonts-liberation \
        xvfb xdotool imagemagick \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --install /usr/bin/clang clang /usr/bin/clang-15 100 \
    && update-alternatives --install /usr/bin/clang++ clang++ /usr/bin/clang++-15 100 \
    && mkdir -m 1777 /tmp/.X11-unix

ENV LANG=C.UTF-8

WORKDIR /BUILD
